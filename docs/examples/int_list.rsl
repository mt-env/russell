// a recursive ADT: a linked list of integers

typedef List('a) {
    nil(),
    cons(head: Int, tail: List('a))
}


fn length(xs: List('a)) -> Int {
    return match xs {
        nil() -> 0,
        cons(head, tail) -> 1 + length(tail)
    };
}

fn sum(xs: List(Int)) -> Int {
    return match xs {
        nil() -> 0,
        cons(head, tail) -> head + sum(tail)
    };
}

fn map_inc(xs: List(Int)) -> List(Int) {
    return match xs {
        nil() -> nil(),
        cons(head, tail) -> cons(head + 1, map_inc(tail))
    };
}

fn main() -> Int {
    // build the list [1, 2, 3, 4]
    let xs = cons(1, cons(2, cons(3, cons(4, nil()))));

    echo Int length(xs);
    echo Int sum(xs);
    echo Int sum(map_inc(xs));

    return 0;
}
